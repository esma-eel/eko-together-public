# ==============================================================================
# Eko-Together / Discussion Forum - Global Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=dev-insecure-django-secret-key-change-in-production-1234567890

# --- Database 1: PostgreSQL User & Auth ---
POSTGRES_AUTH_HOST=localhost
POSTGRES_AUTH_PORT=5432
POSTGRES_AUTH_DB=auth_db
POSTGRES_AUTH_USER=auth_user
POSTGRES_AUTH_PASSWORD=auth_password
POSTGRES_AUTH_URL=postgresql://auth_user:auth_password@localhost:5432/auth_db

# --- Database 2: PostgreSQL Forum ---
POSTGRES_FORUM_HOST=localhost
POSTGRES_FORUM_PORT=5433
POSTGRES_FORUM_DB=forum_db
POSTGRES_FORUM_USER=forum_user
POSTGRES_FORUM_PASSWORD=forum_password
POSTGRES_FORUM_URL=postgresql://forum_user:forum_password@localhost:5433/forum_db

# --- Database 3: PostgreSQL Voting Dedicated ---
POSTGRES_VOTING_HOST=localhost
POSTGRES_VOTING_PORT=5434
POSTGRES_VOTING_DB=voting_db
POSTGRES_VOTING_USER=voting_user
POSTGRES_VOTING_PASSWORD=voting_password
POSTGRES_VOTING_URL=postgresql://voting_user:voting_password@localhost:5434/voting_db

# --- Database 4: MongoDB Post & Comment Cluster ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=posts_comments_db
MONGO_INITDB_ROOT_USERNAME=mongo_admin
MONGO_INITDB_ROOT_PASSWORD=mongo_password
MONGO_URI=mongodb://mongo_admin:mongo_password@localhost:27017/posts_comments_db?authSource=admin

# --- Database 5: Redis Cache & CQRS Read Store ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Message Broker: RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=rabbit_user
RABBITMQ_DEFAULT_PASS=rabbit_password
RABBITMQ_URL=amqp://rabbit_user:rabbit_password@localhost:5672//

# --- Search Engine: Elasticsearch ---
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://localhost:9200

# --- Object Storage: MinIO (S3 Local Simulation) ---
MINIO_ENDPOINT=localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password
MINIO_USE_SSL=False
MINIO_BUCKET_NAME=forum-media
MINIO_PUBLIC_URL=http://localhost:9000/forum-media

# --- Asymmetric JWT Configuration (RS256) ---
JWT_ALGORITHM=RS256
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7
JWT_ISSUER=eko-together-auth-service
JWT_AUDIENCE=eko-together-api
JWT_PRIVATE_KEY_PATH=keys/private_key.pem
JWT_PUBLIC_KEY_PATH=keys/public_key.pem

# --- Edge API Gateway & Access Control ---
GATEWAY_PORT=80
# Secret token stamped by API Gateway and validated by GatewayEnforcementMiddleware via constant-time comparison
GATEWAY_ORIGIN_SECRET=eko-gateway
# Set to true to allow direct port access (8001-8007) for debugging. Default is false (enforces Port 80 Gateway).
ALLOW_DIRECT_SERVICE_ACCESS=false
