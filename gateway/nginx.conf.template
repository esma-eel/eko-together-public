user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 2048;
    use epoll;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Logging Settings
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for" '
                    'rt=$request_time uct="$upstream_connect_time" uht="$upstream_header_time" urt="$upstream_response_time"';

    access_log /var/log/nginx/access.log main;

    # Performance Tuning
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    server_tokens off;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types
        application/json
        application/javascript
        application/x-javascript
        text/css
        text/plain
        text/xml
        application/xml
        application/xml+rss;

    # Rate Limiting Zones
    limit_req_zone $binary_remote_addr zone=api_general_limit:10m rate=60r/s;
    limit_req_zone $binary_remote_addr zone=api_auth_limit:10m rate=15r/s;
    limit_req_zone $binary_remote_addr zone=api_write_limit:10m rate=30r/s;
    limit_req_status 429;

    # Upstream Definitions for Monorepo Microservices
    upstream auth_upstream {
        server auth_user_service:8001;
        keepalive 32;
    }

    upstream forum_upstream {
        server forum_service:8002;
        keepalive 32;
    }

    upstream media_upstream {
        server media_service:8003;
        keepalive 32;
    }

    upstream post_comment_upstream {
        server post_comment_service:8004;
        keepalive 32;
    }

    upstream voting_upstream {
        server voting_service:8005;
        keepalive 32;
    }

    upstream feed_upstream {
        server feed_service:8006;
        keepalive 32;
    }

    upstream search_upstream {
        server search_service:8007;
        keepalive 32;
    }

    server {
        listen 80;
        listen [::]:80;
        server_name localhost _;

        # Client Body Constraints
        client_max_body_size 25M;
        client_body_buffer_size 128k;

        # Standard Proxy Headers
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Gateway-Time $msec;
        # Gateway Origin authentication header (dynamically populated from GATEWAY_ORIGIN_SECRET via envsubst)
        # Note: Client-supplied X-Gateway-Origin headers are explicitly overwritten here to prevent spoofing.
        proxy_set_header X-Gateway-Origin "${GATEWAY_ORIGIN_SECRET}";

        # Security Headers
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;

        # CORS Support for Frontend Single Page Applications
        set $cors_origin "*";
        if ($http_origin ~* "^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$") {
            set $cors_origin $http_origin;
        }

        # ----------------------------------------------------------------------
        # Central Interactive Documentation & Swagger UI
        # ----------------------------------------------------------------------
        location = / {
            return 302 /docs/;
        }

        location = /docs {
            return 302 /docs/;
        }

        location = /docs/ {
            alias /usr/share/nginx/html/;
            index swagger.html;
            try_files /swagger.html =404;
        }

        location = /swagger {
            return 302 /docs/;
        }

        location = /swagger/ {
            return 302 /docs/;
        }

        # Central OpenAPI Schema Proxies for All 7 Microservices
        location = /docs/schema/auth.json {
            proxy_pass http://auth_upstream/docs/openapi.json;
        }

        location = /docs/schema/forum.json {
            proxy_pass http://forum_upstream/docs/openapi.json;
        }

        location = /docs/schema/media.json {
            proxy_pass http://media_upstream/docs/openapi.json;
        }

        location = /docs/schema/posts.json {
            proxy_pass http://post_comment_upstream/docs/openapi.json;
        }

        location = /docs/schema/voting.json {
            proxy_pass http://voting_upstream/docs/openapi.json;
        }

        location = /docs/schema/feed.json {
            proxy_pass http://feed_upstream/docs/openapi.json;
        }

        location = /docs/schema/search.json {
            proxy_pass http://search_upstream/docs/openapi.json;
        }

        # Global Gateway Healthcheck
        location = /health {
            access_log off;
            add_header Content-Type application/json;
            return 200 '{"status":"healthy","service":"api_gateway","version":"1.0.0"}';
        }

        # ----------------------------------------------------------------------
        # 1. User & Authentication Service (/api/v1/auth/*, /api/v1/profiles/*, /api/v1/users/*)
        # ----------------------------------------------------------------------
        location /api/v1/auth/ {
            limit_req zone=api_auth_limit burst=20 nodelay;
            proxy_pass http://auth_upstream;
        }

        location /api/v1/profiles/ {
            limit_req zone=api_general_limit burst=40 nodelay;
            proxy_pass http://auth_upstream;
        }

        location /api/v1/users/ {
            limit_req zone=api_general_limit burst=30 nodelay;
            proxy_pass http://auth_upstream;
        }

        # ----------------------------------------------------------------------
        # 2. Forum Service (/api/v1/forums/*)
        # ----------------------------------------------------------------------
        location /api/v1/forums/ {
            limit_req zone=api_general_limit burst=50 nodelay;
            proxy_pass http://forum_upstream;
        }

        # ----------------------------------------------------------------------
        # 3. Media Presigned Upload Service (/api/v1/media/*)
        # ----------------------------------------------------------------------
        location /api/v1/media/ {
            limit_req zone=api_write_limit burst=20 nodelay;
            proxy_pass http://media_upstream;
        }

        # ----------------------------------------------------------------------
        # 4. Voting Service High-Speed Ingestion (/api/v1/posts/:id/votes/*, /api/v1/comments/:id/votes/*)
        # High precedence regex matching ensures voting routes are directed to Voting DB, not MongoDB
        # ----------------------------------------------------------------------
        location ~ ^/api/v1/(posts|comments)/[^/]+/votes(/.*)?$ {
            limit_req zone=api_write_limit burst=40 nodelay;
            proxy_pass http://voting_upstream;
        }

        # ----------------------------------------------------------------------
        # 5. Post & Comment Service (/api/v1/posts/*, /api/v1/comments/*)
        # ----------------------------------------------------------------------
        location /api/v1/posts/ {
            limit_req zone=api_write_limit burst=40 nodelay;
            proxy_pass http://post_comment_upstream;
        }

        location /api/v1/comments/ {
            limit_req zone=api_write_limit burst=40 nodelay;
            proxy_pass http://post_comment_upstream;
        }

        # ----------------------------------------------------------------------
        # 6. Feed & CQRS Ranking Service (/api/v1/feeds/*)
        # ----------------------------------------------------------------------
        location /api/v1/feeds/ {
            limit_req zone=api_general_limit burst=60 nodelay;
            proxy_pass http://feed_upstream;
        }

        # ----------------------------------------------------------------------
        # 7. Search & Discovery Elasticsearch Service (/api/v1/search/*)
        # ----------------------------------------------------------------------
        location /api/v1/search/ {
            limit_req zone=api_general_limit burst=60 nodelay;
            proxy_pass http://search_upstream;
        }

        # Internal routes protection (block external callers from reaching internal service meshes)
        location /internal/ {
            deny all;
            return 403 '{"detail":"Access denied: internal network only"}';
        }

        # Fallback 404 for unrouted paths
        location / {
            add_header Content-Type application/json;
            return 404 '{"error":"Endpoint not found on API Gateway","code":"NOT_FOUND"}';
        }
    }
}
