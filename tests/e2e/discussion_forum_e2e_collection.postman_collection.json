    {
      "name": "07. Forum - User A Creates Community",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var rand = Math.floor(Math.random() * 100000);",
              "pm.environment.set('forum_slug', 'dist-sys-' + rand);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Forum created by User A', function () {",
              "    pm.response.to.have.status(201);",
              "    var json = pm.response.json();",
              "    pm.expect(json.slug).to.eql(pm.environment.get('forum_slug'));",
              "    pm.environment.set('forum_id', json.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{user_a_token}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Distributed Systems Guild\",\n  \"slug\": \"{{forum_slug}}\",\n  \"description\": \"Architecture patterns and high availability engineering.\",\n  \"rules\": \"1. Cite benchmarks\\n2. Respect peers\",\n  \"post_permission\": \"ALL_MEMBERS\",\n  \"require_approval_to_join\": false\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/forums/",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "forums", ""]
        }
