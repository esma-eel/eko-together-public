  "item": [
    {
      "name": "01. API Gateway Healthcheck",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Gateway returns 200 Healthy', function () {",
              "    pm.response.to.have.status(200);",
              "    var data = pm.response.json();",
              "    pm.expect(data.status).to.eql('healthy');",
              "    pm.expect(data.service).to.eql('api_gateway');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "02. Auth - Signup User A",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var rand = Math.floor(Math.random() * 100000);",
              "pm.environment.set('user_a_username', 'architect_' + rand);",
              "pm.environment.set('user_a_email', 'architect_' + rand + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('User A registered successfully', function () {",
              "    pm.response.to.have.status(201);",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('profile_id');",
              "    pm.environment.set('user_a_profile_id', json.profile_id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{user_a_username}}\",\n  \"email\": \"{{user_a_email}}\",\n  \"password\": \"P@ssword123456!\",\n  \"display_name\": \"Senior Architect A\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/signup/",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "signup", ""]
        }
      }
    },
